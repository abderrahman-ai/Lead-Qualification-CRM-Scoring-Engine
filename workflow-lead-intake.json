      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst contact = $input.first().json;\nconst props = contact.properties || {};\n\nfunction getProp(key) {\n  const p = props[key];\n  if (!p) return '';\n  return (typeof p === 'object' && p !== null) ? (p.value || '') : String(p);\n}\n\n// telegram_chat_id is a custom HubSpot property the lead's Telegram ID is stored in\nconst telegramChatId = getProp('telegram_chat_id').trim();\n\nreturn [{ json: {\n  contact_id: String(contact.vid || contact.id || ''),\n  email: getProp('email'),\n  first_name: getProp('firstname'),\n  last_name: getProp('lastname'),\n  telegram_chat_id: telegramChatId,\n} }];\n"
      },
      "id": "c5bff0bf-b69e-4cc5-ac26-1033fd7a04b5",
      "name": "Extract Contact Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "telegram-id-not-empty",
              "leftValue": "={{ $json.telegram_chat_id }}",
              "rightValue": "",
              "operator": {
