      "id": "4f1c568a-d233-40ed-84e4-1e88143fa42b",
      "name": "Lead Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        576
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst lead = $('Get Lead State').first().json;\nconst replyText = $('Parse Telegram Message').first().json.reply_text || '';\n\n// Rule-based parsing: extract meaningful value from free-text reply\nconst step = Number(lead.question_step) || 1;\nconst parsedValue = replyText.trim();\nconst needsClarification = false;\nconst clarifyingQuestion = '';\n\n// Accumulate raw answers\nconst existing = lead.raw_answers || '';\nconst rawAnswers = existing ? existing + ' | Q' + step + ': ' + replyText : 'Q' + step + ': ' + replyText;\n\n// Map answer to field\nlet intent = lead.intent || '';\nlet budget = lead.budget || '';\nlet financing = lead.financing || '';\nlet timeline = lead.timeline || '';\n\nif (!needsClarification) {\n  if (step === 1) intent = parsedValue;\n  else if (step === 2) budget = parsedValue;\n  else if (step === 3) financing = parsedValue;\n  else if (step === 4) timeline = parsedValue;\n}\n\nconst nextStep = needsClarification ? step : step + 1;\nconst isComplete = !needsClarification && step === 4;\n\n// ── Scoring ──────────────────────────────────────────────────────\nlet score = 0;\n\n// Budget match (0-30)\nconst budgetLower = budget.toLowerCase().replace(/,/g, '');\nconst budgetMatch = budgetLower.match(/(\\d+\\.?\\d*)[k]?/);\nlet budgetNum = 0;\nif (budgetMatch) {\n  budgetNum = parseFloat(budgetMatch[1]);\n  if (budgetLower.includes('k') && budgetNum < 10000) budgetNum = budgetNum * 1000;\n  if (budgetLower.includes('m') || budgetLower.includes('million')) budgetNum = budgetNum * 1000000;\n}\nif (budgetNum >= 500000) score += 30;\nelse if (budgetNum >= 200000) score += 20;\nelse if (budgetNum >= 100000) score += 10;\nelse if (budget && budget.length > 0) score += 5;\n\n// Timeline urgency (0-25)\nconst tlLower = timeline.toLowerCase();\nif (tlLower.match(/asap|immediate|now|this month|< ?1|less than.*month/)) score += 25;\nelse if (tlLower.match(/1|2|3 month|within.*month|quarter/)) score += 20;\nelse if (tlLower.match(/6 month|half.*year/)) score += 12;\nelse if (tlLower.match(/year|12 month/)) score += 6;\nelse if (timeline && timeline.length > 0) score += 3;\n\n// Financing readiness (0-25)\nconst finLower = financing.toLowerCase();\nif (finLower.match(/confirm|approved|mortgage.*broker|pre.?approv|ready/)) score += 25;\nelse if (finLower.match(/broker|working with|in process|discussing/)) score += 15;\nelse if (finLower.match(/cash|liquid|self.?fund/)) score += 25;\nelse if (financing && financing.length > 0) score += 5;\n\n// Engagement quality (0-20)\nconst totalWords = (intent + ' ' + budget + ' ' + financing + ' ' + timeline).split(' ').length;\nif (totalWords >= 20) score += 20;\nelse if (totalWords >= 10) score += 14;\nelse if (totalWords >= 4) score += 8;\nelse if (totalWords >= 1) score += 4;\n\n// Segment\nlet segment = '';\nif (isComplete) {\n  if (score >= 75) segment = 'Hot';\n  else if (score >= 40) segment = 'Warm';\n  else segment = 'Cold';\n}\n\nconst questions = [\n  '',\n  'Are you looking to buy, rent, or invest?',\n  \"What's your target budget range?\",\n  'Are you working with a mortgage broker or do you have financing confirmed?',\n  \"What's your target move-in or acquisition timeline?\",\n];\n\nconst nextQuestion = needsClarification\n  ? clarifyingQuestion\n  : (nextStep <= 4 ? questions[nextStep] : '');\n\nreturn [{ json: {\n  contact_id: lead.contact_id,\n  telegram_chat_id: lead.phone,\n  email: lead.email,\n  first_name: lead.first_name,\n  last_name: lead.last_name,\n  question_step: nextStep,\n  intent: intent,\n  budget: budget,\n  financing: financing,\n  timeline: timeline,\n  raw_answers: rawAnswers,\n  qualification_score: score,\n  segment: segment,\n  status: isComplete ? 'scored' : 'qualifying',\n  next_question: nextQuestion,\n  is_complete: isComplete,\n  needs_clarification: needsClarification,\n  last_updated: new Date().toISOString(),\n} }];\n"
      },
